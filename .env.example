# Gere com: python -c "import secrets; print(secrets.token_urlsafe(32))"
GODATA_API_KEY=troque-por-uma-chave-forte

GODATA_ODBC_DRIVER=ODBC Driver 18 for SQL Server
GODATA_ENCRYPT=true
GODATA_TRUST_SERVER_CERTIFICATE=false
GODATA_CONNECTION_TIMEOUT_SECONDS=10
# 0 desativa o timeout de execução; o timeout de conexão continua separado.
GODATA_QUERY_TIMEOUT_SECONDS=0
GODATA_MAX_ROWS=10000
GODATA_MAX_QUERY_LENGTH=100000
GODATA_MAX_CONCURRENT_QUERIES=10
